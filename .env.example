# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → Data API (URL) and API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security. Server-side only — never commit it, never expose
# it to the browser. Used by the bulk importer and the extraction pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudinary — Dashboard → Product Environment Credentials
#
# Only the cloud name is public; it appears in delivery URLs. The API key and
# secret sign uploads from the server and must stay server-side.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Top-level folder every uploaded asset is filed under. Default: qp
CLOUDINARY_UPLOAD_FOLDER=qp

# "on" serves resized WebP/AVIF copies of images. Each new copy counts against
# the Cloudinary plan, so it is off by default and images are served as uploaded.
NEXT_PUBLIC_CLOUDINARY_TRANSFORMS=

# A second account holding the answer-key figure sheets (scripts/answer-keys).
CLOUDINARY_SHEETS_CLOUD_NAME=
CLOUDINARY_SHEETS_API_KEY=
CLOUDINARY_SHEETS_API_SECRET=

# ---------------------------------------------------------------------------
# Anthropic — only needed for `npm run paper:extract` (scan → block JSON)
# console.anthropic.com → API Keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google sign-in — Google Cloud Console -> Credentials -> OAuth 2.0 Client ID.
# Public: it ships to the browser for Google Identity Services. Add the site
# origin(s) as Authorized JavaScript origins on that client.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secret for /api/revalidate, which scripts call to clear the site cache.
REVALIDATE_SECRET=

# Optional. Ownership tokens for Google Search Console and Bing Webmaster
# Tools, if the sites are verified by meta tag rather than DNS. Only the
# token itself: the content="…" value the tools show. docs/seo.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Shown on /privacy and /terms as the address for privacy questions and
# deletion requests. Google's YouTube API audit requires one.
NEXT_PUBLIC_CONTACT_EMAIL=
# Privacy, data and deletion requests, takedowns and legal notices (falls back to the contact address)
NEXT_PUBLIC_LEGAL_EMAIL=

# ---------------------------------------------------------------------------
# YouTube — server only. Never give any of these a NEXT_PUBLIC_ prefix.
# docs/youtube.md has the full walkthrough.
#
# Linking a video that was uploaded by hand in YouTube Studio works with none
# of these set. They add the channel check and, after Google's audit, the
# one-click upload.
# ---------------------------------------------------------------------------

# OAuth client from a separate Google Cloud project (quizpractice-youtube):
# APIs & Services → Credentials → Create credentials → OAuth client ID → Web
# application. Authorised redirect URI: NEXT_PUBLIC_SITE_URL + /api/youtube/callback
# The client id ends in .apps.googleusercontent.com.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Encrypts the channel's refresh token at rest (AES-256-GCM). 32 random bytes,
# base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it means connecting the channel again.
YOUTUBE_TOKEN_KEY=

# Optional. Same Cloud project → Credentials → API key, restricted to
# "YouTube Data API v3". Lets the site check pasted links before a channel is
# connected. Each check costs 1 of the 10,000 free daily units.
YOUTUBE_API_KEY=

# Optional but recommended. The Unknown IITians channel id (starts with UC):
# YouTube Studio → Settings → Channel → Advanced settings. Links from any other
# channel are refused, and only this channel can be connected.
YOUTUBE_CHANNEL_ID=

# "on" gives teachers the one-click "Upload to YouTube". Leave it empty until
# the YouTube API audit has passed: before that, every upload is locked Private.
YOUTUBE_API_UPLOADS=

# Optional but recommended once a channel is connected. Vercel sends it as a
# Bearer token with each scheduled call (vercel.json → crons), so only Vercel
# can run the daily check that the saved YouTube permission still works. Any
# random string of 16 characters or more, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cashfree Payments — Merchant Dashboard → Developers → API Keys
# ---------------------------------------------------------------------------
# "production" for live payments, anything else for the sandbox (test keys).
# Server-side only: never NEXT_PUBLIC_, never committed. The secret key also
# signs Cashfree's webhooks (src/lib/cashfree.ts).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
