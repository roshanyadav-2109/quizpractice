      "number": 1,
      "type": "mcq",
      "marks": 1,
      "body": [
        {
          "type": "text",
          "md": "Which of the following components of the Database Management System (DBMS) is primarily responsible for generating and selecting the most cost-effective execution plan for a given SQL query?"
        }
      ],
      "options": [
        { "label": "A", "content": [{ "type": "text", "md": "Parser and Translator" }] },
        { "label": "B", "content": [{ "type": "text", "md": "Query Optimizer" }], "is_correct": true },
        { "label": "C", "content": [{ "type": "text", "md": "Evaluation Engine" }] },
        { "label": "D", "content": [{ "type": "text", "md": "Buffer Manager" }] }
      ],
      "solution": {
        "kind": "authored",
        "body": [
          {
            "type": "text",
            "md": "The **query optimizer** enumerates candidate execution plans and picks the one with the lowest estimated cost. The parser only checks syntax and produces a parse tree, the evaluation engine *runs* the chosen plan, and the buffer manager handles page caching between disk and memory."
          }
        ],
        "video_url": "https://www.youtube.com/watch?v=REPLACE_ME"
      },
      "topics": ["dbms-architecture", "query-processing"],
      "difficulty": "easy"
    },

