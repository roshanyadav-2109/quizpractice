# Quiz Space (a separate project: /srv/quizspace, service quizspace, port 3100). Added 2026-10-03.
# Kept in its own file so the other sites in /etc/caddy/Caddyfile are never edited for it:
# /etc/caddy/Caddyfile has one line, `import /etc/caddy/quizspace.caddy`.
quizspace.unknowniitians.com {
	encode zstd gzip

	# Behind Cloudflare the connection comes from a Cloudflare address and the visitor's own address is in
	# Cf-Connecting-Ip. That header is believed ONLY when the connection really is from Cloudflare (list from
	# https://www.cloudflare.com/ips ), so nobody can fake it. Without Cloudflare (a direct connection) the
	# visitor address is the connection address. Everything below uses X-Real-IP / "client" as the visitor.
	# The two request_header lines overwrite any X-Real-IP a visitor sends (one of them always applies). Do not add a
	# `request_header -X-Real-IP`: Caddy runs deletes after sets and it would remove the header again.
	@cf remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @direct X-Real-IP {remote_host}
	request_header @cf X-Real-IP {header.Cf-Connecting-Ip}
	log_append @direct client {remote_host}
	log_append @cf client {header.Cf-Connecting-Ip}

	# Origin lock: this site is reached only through Cloudflare. A direct connection to the server's address
	# (which skips Cloudflare's bot filter, flood rule and bans) is refused. The server itself is allowed so
	# its own checks work. Remove these two lines to open the server again.
	@bypass not remote_ip 127.0.0.1/8 ::1 62.72.29.5 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @bypass "Use https://quizspace.unknowniitians.com" 403

	# A connection that copied the question bank; the app also blocks by address and account.
	@scraper header X-Real-IP 122.176.158.89
	respond @scraper 403

	# Access log for fail2ban (the trap and the rate limits). Static files are left out to keep it small.
	# (/var/log/caddy was refused by the service sandbox; /var/lib/caddy is Caddy's own writable folder.)
	@static path /_next/static/* /_next/image* /art/* /brand/* /showcase/* /favicon.ico
	log_skip @static
	log {
		output file /var/lib/caddy/logs/quizspace.access.log {
			roll_size 50MiB
			roll_keep 3
		}
		format json
	}
	# Vercel added HSTS by itself; on the server it has to be said. Only for this host (no subdomains, no preload).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
	}

	# The app reads the visitor address from X-Real-IP (its limits, blocks and the activity record), set above.
	# Two copies of the app (A on 3100, B on 3101): each uses about one core, so two double what the site can serve.
	# Least busy copy first; if one is restarting (a deploy) or down, the other takes the request.
	reverse_proxy 127.0.0.1:3100 127.0.0.1:3101 {
		lb_policy least_conn
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 5s
		max_fails 2
	}
}
